# Supabase Configuration (Client-side)
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api

#VITE_SUPABASE_URL=https://your-project.supabase.co
#VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Fastify server (Supabase → Fastify migration, Part 1)
# When VITE_USE_SERVER=true, edge functions listed in MIGRATED_FUNCTIONS
# (webapp/src/api/client.ts) are invoked on the Fastify server at
# VITE_API_URL instead of supabase.functions.invoke. Default: off.
#VITE_USE_SERVER=false
#VITE_API_URL=http://localhost:8090

# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...

# RESEND_API_KEY=re_...

# MUX_TOKEN_ID=...
# MUX_TOKEN_SECRET=...
# MUX_WEBHOOK_SECRET=...