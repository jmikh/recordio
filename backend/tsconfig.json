{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "sourceMap": true,
    "paths": {
      "@shared/*": ["../shared/*"]
    },
    "rootDir": ".."
  },
  "include": ["src", "../shared", "../render-worker/src"],
  "exclude": ["node_modules", "dist", "../shared/components", "../shared/assets", "../shared/theme"]
}
