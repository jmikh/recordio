# Server
PORT=3000

# Supabase (secret key — never expose to clients)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# OpenAI
OPENAI_API_KEY=sk-...

# CORS — comma-separated origins
CORS_ORIGIN=https://app.recordio.cc,http://localhost:3001

# Rate limit — transcription minutes per billing cycle (monthly)
MONTHLY_MINUTES_LIMIT=60
