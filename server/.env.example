# Copy to .env.local for local dev (`npm run dev` loads it)

PORT=8090

# Local dev: the `supabase start` Postgres.
# Production (Railway): Supavisor pooled connection string, transaction mode.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Local dev: the local `supabase start` stack.
SUPABASE_URL=http://127.0.0.1:54321

# Legacy HS256 secret. Local dev: the well-known demo secret.
# Production (Railway): dashboard → Project Settings → API → JWT Settings.
# (New "JWT signing keys" tokens are verified via SUPABASE_URL's JWKS instead.)
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Service-role key for Supabase platform APIs (auth admin user lookup).
# Local dev: the `supabase start` stack's fixed secret key.
# Production (Railway): dashboard → Project Settings → API keys.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxx

# Stripe — required. Local dev: TEST-MODE key + test-mode price ids
# (dashboard in test mode → Developers → API keys / Product catalog).
# Production (Railway): same values as the edge function secrets.
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PRICE_ID_MONTHLY=price_xxxxx
STRIPE_PRICE_ID_YEARLY=price_xxxxx

# Signing secret of the Stripe webhook ENDPOINT posting to
# /stripe-webhooks — required. CAREFUL: each Stripe webhook endpoint
# has its OWN secret (dashboard → Developers → Webhooks); use the
# secret of whichever endpoint actually points at this server (or
# `stripe listen --print-secret` for local forwarding).
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# S3-compatible storage (project-media bucket). Local dev: the `supabase
# start` storage S3 endpoint with the CLI's fixed local credentials.
# Production (Railway): same values as the edge function secrets.
S3_REGION=local
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Render worker (render-job-create dispatch) — required. Local dev: the
# locally-running worker (render-worker/ defaults to port 8080 — avoid
# colliding with this server's PORT) + the shared dev secret (root
# .env.test has it). Production (Railway): same values as the edge
# function secrets.
RENDER_WORKER_URL=http://localhost:8080
RENDER_SECRET=xxxxx

# OpenAI Whisper (transcribe) — required. Same value as the edge
# function secret (dashboard → Edge Functions → Secrets).
OPENAI_API_KEY=sk-xxxxx

# Resend (welcome + workspace-invite emails) — required. Same value as
# the edge function secret.
RESEND_API_KEY=re_xxxxx

# Mux (mux-video-create asset ingest) — required. Same values as the
# edge function secrets (Mux dashboard → Settings → Access Tokens).
MUX_TOKEN_ID=xxxxx
MUX_TOKEN_SECRET=xxxxx

# Signing secret of the Mux webhook ENDPOINT posting to
# /mux-video-webhook — required. CAREFUL: each Mux webhook endpoint has
# its OWN secret (Mux dashboard → Settings → Webhooks); use the secret
# of whichever endpoint actually points at this server.
MUX_WEBHOOK_SECRET=xxxxx

# This server's own public base URL — the render worker posts status
# callbacks to ${PUBLIC_URL}/render-job-webhook. Local dev: this server.
# Production (Railway): https://recordio-production.up.railway.app
PUBLIC_URL=http://localhost:8090

# Axiom log shipping (app-side pino transport) — required. Datasets are
# per-environment: recordio-server (prod/Railway), recordio-server-dev
# (local dev) — so prod dashboards/monitors need no env filters. Token
# needs ingest permission on the dataset (Axiom → Settings → API tokens).
AXIOM_TOKEN=xaat-xxxxx
AXIOM_DATASET=recordio-server-dev

# Optional — leave unset to disable Sentry locally
# SENTRY_DSN=
