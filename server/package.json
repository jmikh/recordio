{
  "name": "recordio-server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "start": "node dist/server.js",
    "dev": "tsx --env-file=.env.local src/server.ts",
    "dev:prod": "tsx --env-file=.env.prod src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sentry/node": "^10.65.0",
    "@sinclair/typebox": "^0.34.52",
    "@supabase/supabase-js": "^2.110.6",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.2.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
